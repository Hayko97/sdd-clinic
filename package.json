{
  "name": "sdd-clinic",
  "version": "0.1.2",
  "description": "A local, spec-driven development workspace for Codex and Claude CLI",
  "type": "module",
  "bin": {
    "sddclinic": "bin/sddclinic.mjs",
    "sdd-clinic": "bin/sddclinic.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "bin",
    "runtime",
    "Dockerfile.cli",
    "Dockerfile.cli.dockerignore",
    "pnpm-workspace.yaml",
    "LICENSE",
    "NOTICE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "docker compose up --build",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "docker compose up -d",
    "doctor": "tsx src/server/cli.ts doctor",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}' 'tests/**/*.{ts,cjs}'",
    "prepack": "pnpm build && node scripts/prepare-package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "spec:validate": "openspec validate --all --strict",
    "check": "pnpm typecheck && pnpm test && pnpm spec:validate && pnpm build",
    "docker:logs": "docker compose logs -f clinic",
    "docker:stop": "docker compose stop",
    "install:global": "node scripts/install-global.mjs",
    "pack:release": "node scripts/pack-release.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.2.0",
    "@fission-ai/openspec": "1.14.2",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@napi-rs/keyring": "^1.2.0",
    "diff": "^8.0.2",
    "fastify": "^5.6.2",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "mongodb": "^6.21.0",
    "mysql2": "^3.15.3",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "ssh2": "^1.17.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/diff": "^7.0.2",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.25.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hayko97/sdd-clinic.git"
  },
  "homepage": "https://github.com/Hayko97/sdd-clinic#readme",
  "bugs": {
    "url": "https://github.com/Hayko97/sdd-clinic/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "sdd",
    "spec-driven-development",
    "openspec",
    "codex",
    "claude",
    "cli"
  ]
}
